# Copy to .env on the server and fill in the values (never commit .env)
# Nested settings use a double underscore: Stripe__SecretKey = "Stripe:SecretKey" in appsettings.json
# Wrap secrets in single quotes, so a "$" inside them is not read as a variable

ConnectionStrings__DefaultConnection='Host=;Port=;Database=;Username=;Password=;SSL Mode=Require'

Jwt__SecretKey=''
Jwt__Issuer=NorskHandverk
Jwt__Audience=NorskHandverkClient
Jwt__ExpiryMinutes=60

Stripe__SecretKey=''
Stripe__PublishableKey=''
Stripe__WebhookSecret=''

Cors__AllowedOrigins__0=https://norsk-handverk.vercel.app

B2Storage__ServiceUrl=https://s3.eu-central-003.backblazeb2.com
B2Storage__BucketName=norskhandverk-images
B2Storage__KeyId=''
B2Storage__ApplicationKey=''

AbandonedCarts__TimeoutMinutes=1440
AbandonedCarts__CheckIntervalMinutes=60
